# Copy this file to .env.local for local development:
#   copy .env.example .env.local
#
# Start with:
#   docker compose --env-file .env.local -f docker-compose.local.yml up --build

COMPOSE_PROJECT_NAME=018-hai

# Shared database defaults for local containers.
DB_USER=postgres
DB_PASSWORD=change-this-local-db-password
DB_PORT=5432
# The API runs with this DML-only account. Compose applies reviewed migrations
# with DB_USER first, then provisions/rotates this account before the API starts.
BACKEND_DB_USER=hai_runtime
BACKEND_DB_PASSWORD=change-this-local-db-password
# The backend never changes schema at normal startup. The one-shot
# backend-migrate service is the only default migration path.
DB_MIGRATIONS_ENABLED=false

# Backend PostgreSQL pool only (the separate IDP is not covered by these caps).
# 0/unlimited and fewer than 2 open connections are rejected. Idle may be 0.
# Durations require units; caps do not reserve final-effect authorization slots.
DB_MAX_OPEN_CONNS=8
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_IDLE_TIME=2m
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s
DB_OPEN_TIMEOUT=10s
# Whole shared-pool initialization, including optional startup migrations.
DB_STARTUP_TIMEOUT=5m

# One-shot backend reconcile/migrate commands: shared acquisition + SQL deadline.
# Positive duration with units; earlier committed migrations are not undone on timeout.
HAI_COMMAND_TIMEOUT=30m

# IDP database.
IDP_DB_NAME=idp
IDP_DB_HOST=postgres-idp
# Cooperative IDP startup deadline covering connection, migrations and seeding.
IDP_DB_STARTUP_TIMEOUT=5m

# Automation database.
AUTOMATION_DB_NAME=automation_hub
AUTOMATION_DB_HOST=postgres-automation

# Service ports inside the Docker network.
WEB_SERVER_PORT=8080
SERVER_PORT=80
BASE_URL=/api
# --- Secrets ------------------------------------------------------------------
# Every "change-this-*" value below is a placeholder, not a secret. Run
#   ./scripts/generate-secrets.sh >> .env.local
# to produce real ones.
#
# With RUN_MODE=production, /readyz reports `not_ready` (HTTP 503) while any
# required security secret is empty or still holds its placeholder, and the
# backend container is marked unhealthy. The API also rejects protected traffic
# when BACKEND_API_SHARED_KEY is empty or still an example value. That is
# deliberate: a missing or default credential must stop a production deployment,
# not sail through it.
BACKEND_API_SHARED_KEY=change-this-local-backend-key
# Use a separate long random passphrase in production. In explicit demo/test
# mode only, an empty value falls back to the backend shared key for local
# compatibility; production private chat import stays unavailable without it.
HAI_MEMORY_ENCRYPTION_KEY=change-this-local-memory-encryption-key
# Per-client-IP request cap per minute. 0 (default) disables rate limiting.
RATE_LIMIT_PER_MINUTE=0

# Prometheus metrics are disabled unless explicitly enabled. The endpoint is
# bearer-token protected and should be scraped only by a local collector.
HAI_PROMETHEUS_ENABLED=false
HAI_PROMETHEUS_TOKEN=

# --- Gmail, Google Drive, Google Contacts, and Google Calendar (Google OAuth) -
# Leave empty to keep all four Google connectors honestly reporting unconfigured.
# To enable it, create an OAuth 2.0 Web-application client in Google Cloud
# Console (enable the Gmail, Drive, People, and Calendar APIs; add your address as a test
# user), then set:
#   GOOGLE_OAUTH_CLIENT_ID     the client id
#   GOOGLE_OAUTH_CLIENT_SECRET the client secret
#   GOOGLE_OAUTH_REDIRECT_URL  http://localhost:8088/api/v1/sources/oauth/google/callback
# Google redirects the signed-in browser, so Windows-local operation does not
# require a public tunnel. The URI must match the registered OAuth redirect
# exactly, including the default gateway port 8088. Each source requests one read-only
# scope: Gmail read-only, Drive read-only, Contacts read-only, or Calendar read-only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# Dedicated AES-256-GCM passphrase for stored Google access/refresh tokens.
# Required for account connection; do not reuse JWT, backend, or memory keys.
HAI_OAUTH_TOKEN_ENCRYPTION_KEY=
# Independent HMAC key for the short-lived OAuth callback state.
HAI_OAUTH_STATE_SIGNING_KEY=
# "Sign in with Google" for the app login (separate from the Gmail connector,
# handled by the IDP). Reuses the same client id/secret, but its redirect is a
# distinct path and must ALSO be registered on the Google OAuth client:
#   GOOGLE_LOGIN_REDIRECT_URL=<public-base>/api/v1/auth/google/callback
# Leave empty to hide/disable the Google login button's backend.
GOOGLE_LOGIN_REDIRECT_URL=

# --- Password-reset email (optional SMTP) -----------------------------------
# Password recovery is intentionally unavailable until a private mail sender is
# configured. Use a dedicated mailbox or app password, not a primary password.
# This sender must support STARTTLS (normally port 587). Never commit values in
# .env.local. For a Gmail account, create a Google App Password first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_STARTTLS=true
# Run mode: production | demo | test. Non-production is labelled and performs no
# real external side effects. Unknown/empty defaults to production.
RUN_MODE=production
# Production schema changes must run through reviewed versioned migrations.
# Set true only while developing a new migration baseline.
DB_AUTOMIGRATE=false
BACKEND_PORT=17070
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_ADDR=redis:6379

# --- Host port mappings -------------------------------------------------------
# The gateway is the intended application entry point. Compose also publishes
# the backend, Postgres and Redis to loopback for local diagnostics; none of
# these defaults expose a host port to the LAN. Do not expose the gateway while
# the local login shortcut is enabled.
#
# Override any of these when a port is already taken on the host. The default
# Redis host port is 6380, not 6379, precisely because a developer machine
# commonly already runs Redis on 6379 — publishing there makes the whole stack
# fail to start with "port is already allocated".
GATEWAY_HOST_PORT=8088
# Keep the gateway loopback-only by default. Set 0.0.0.0 only after removing
# LOCAL_LOGIN_BYPASS_ENABLED and reviewing the exposure.
GATEWAY_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6380
IDP_DB_HOST_PORT=5433
AUTOMATION_DB_HOST_PORT=5434

# The event bus is optional. Keep it disabled for the normal local control room;
# enable it together with `--profile event-bus` when a workflow specifically
# needs Kafka-compatible event delivery or dynamic gateway configuration.
HAI_EVENT_BUS_ENABLED=false
# Kafka-protocol event delivery uses one bounded Redpanda broker when enabled.
KAFKA_BROKER=kafka:9092
KAFKA_BROKERS=kafka:9092
BROKERS_ADDR=kafka:9092
KAFKA_TOPIC=automation-events
LOGGER_TOPIC=logger
MAIL_TOPIC=mail
KAFKA_CLIENT_ID=idp
KAFKA_MEMORY_LIMIT=256m
KAFKA_MEMORY_RESERVATION=64m
KAFKA_CPU_LIMIT=0.5
KAFKA_PIDS_LIMIT=96

# Always-on desktop services are bounded too. These are intentionally modest
# defaults for a local Windows 11 install; adjust only after observing an actual
# workload. Optional model, indexing, and evaluation services remain profile-gated.
IDP_MEMORY_LIMIT=256m
IDP_CPU_LIMIT=0.5
IDP_PIDS_LIMIT=128
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
BACKEND_PIDS_LIMIT=256
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_CPU_LIMIT=0.25
FRONTEND_PIDS_LIMIT=64
GATEWAY_MEMORY_LIMIT=128m
GATEWAY_CPU_LIMIT=0.25
GATEWAY_PIDS_LIMIT=64
NGINX_CONFIG_MANAGER_MEMORY_LIMIT=256m
NGINX_CONFIG_MANAGER_CPU_LIMIT=0.5
NGINX_CONFIG_MANAGER_PIDS_LIMIT=128
POSTGRES_IDP_MEMORY_LIMIT=512m
POSTGRES_IDP_CPU_LIMIT=0.75
POSTGRES_IDP_PIDS_LIMIT=128
POSTGRES_AUTOMATION_MEMORY_LIMIT=768m
POSTGRES_AUTOMATION_CPU_LIMIT=1.0
POSTGRES_AUTOMATION_PIDS_LIMIT=192
# One-shot schema migration and runtime-role jobs are bounded independently so
# a cold start cannot consume the desktop without limit.
BACKEND_MIGRATE_MEMORY_LIMIT=512m
BACKEND_MIGRATE_CPU_LIMIT=1.0
BACKEND_MIGRATE_PIDS_LIMIT=128
BACKEND_RUNTIME_ROLE_MEMORY_LIMIT=64m
BACKEND_RUNTIME_ROLE_CPU_LIMIT=0.1
BACKEND_RUNTIME_ROLE_PIDS_LIMIT=32
REDIS_MEMORY_LIMIT=128m
REDIS_CPU_LIMIT=0.25
REDIS_PIDS_LIMIT=64

# Authentication and first-run local admin account.
FIRST_RUN_ADMIN_EMAIL=noodzakelijkonline@gmail.com
FIRST_RUN_ADMIN_PASSWORD=change-this-first-run-admin-password
IDP_COOKIE_SECURE=false
# Optional local dashboard button. Only enable on a loopback-bound single-user
# machine. First-run setup generates this gateway-to-IDP secret automatically.
LOCAL_LOGIN_BYPASS_ENABLED=false
LOCAL_PREVIEW_GATEWAY_SECRET=
JWT_SECRET=change-this-local-secret
# Independent HMAC key for short-lived automation approval capabilities. Use
# at least 32 random bytes and keep the same value across backend restarts and
# instances. Changing it invalidates every unexpired capability.
HAI_APPROVAL_PROOF_SIGNING_KEY=change-this-local-approval-proof-signing-key-at-least-32-bytes
BLOCKING_TIME_EXPONENTIATION_BASIS=2
MAX_LOGIN_ATTEMPTS_BEFORE_BLOCK=5
MIN_TIME_BETWEEN_ATTEMPTS_IN_SECONDS=60
EXPIRATION_TIME_RESET_TOKEN_IN_HOURS=24
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=5
PASSWORD_RESET_TOPIC=password-reset
ACCOUNT_BLOCKED_TOPIC=account-blocked
ACCOUNT_CREATED_TOPIC=account-created

# Backend uploads.
IMAGE_MAX_SIZE_IN_MB=5
IMAGE_EXTENSIONS=.jpg,.jpeg,.png
IMAGE_SAVE_DIR=/root/images

# Controlled automation runtime execution.
AUTOMATION_API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
AUTOMATION_API_ALLOW_LINK_LOCAL=false
AUTOMATION_HEALTH_ALLOWED_HOSTS=localhost,127.0.0.1,::1,backend,frontend,gateway,generic-auto,idp
# Optional network-specific RFC 6052 Pref64 prefixes (IPv6 CIDR, comma-separated).
# Configure the local network's actual Pref64 when DNS64/NAT64 is in use.
AUTOMATION_NAT64_PREFIXES=
AUTOMATION_HEALTH_ALLOW_LINK_LOCAL=false
AUTOMATION_SCRIPT_EXECUTION_ENABLED=false
# Safe regular-file staging currently supports the Linux backend/container.
# Other platforms fail closed. Script files are limited to 16 MiB; execution
# remains approval-gated and is not a subprocess or capability sandbox.
AUTOMATION_SCRIPT_DIR=/root/automation-scripts
AUTOMATION_SCRIPT_TIMEOUT_SECONDS=30
AUTOMATION_SCRIPT_OUTPUT_LIMIT_BYTES=4096
AUTOMATION_SCRIPT_ENV_ALLOWLIST=
# Comma-separated reviewed pins, for example: health.sh=<64 lowercase hex SHA-256>
AUTOMATION_SCRIPT_SHA256_ALLOWLIST=
AUTOMATION_DOCKER_CONTROL_ENABLED=false
AUTOMATION_DOCKER_SOCKET=/var/run/docker.sock
AUTOMATION_DOCKER_ALLOWED_CONTAINERS=

# Phase 2 local worker state. The Compose topology keeps each boundary
# separate: JSON feeds are read-only under ./phase2-feeds, verified safe-worker
# artifacts are confined to ./agent-workspaces/phase2, and emergency-stop plus
# autonomy-mode state is kept in the named Docker volume backed up by the
# Windows recovery procedure. Feed files are opt-in and comma-separated.
HAI_PHASE2_OWNER=local-operator
HAI_PHASE2_WORKSPACE_ID=local
HAI_PHASE2_WORKSPACE_DIR=/root/agent-workspaces/phase2
HAI_PHASE2_FEEDS_DIR=/root/phase2-feeds
HAI_PHASE2_FEED_FILES=
HAI_PHASE2_STATE_DIR=/root/phase2-control-state
HAI_PHASE2_MODE=autonomous_safe
HAI_PHASE2_EMERGENCY_STOP=false

# Connected-source local folder ingestion. Files are read from ./connected-sources
# through this container path and must remain inside the allowlisted root.
CONNECTED_SOURCE_LOCAL_ROOT=/root/connected-sources
CONNECTED_SOURCE_FILE_LIMIT=100
CONNECTED_SOURCE_MAX_BYTES=1048576
# Normalized JSON feeds let local account bridges and reviewed API adapters
# submit source records without storing their credentials in HAI.
CONNECTED_SOURCE_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,api.github.com,api.trello.com
# Exact loopback endpoints are allowed only for local fixtures/development.
# Use host:port entries such as 127.0.0.1:8080; private networks stay blocked.
CONNECTED_SOURCE_HTTP_LOOPBACK_ADDRS=
CONNECTED_SOURCE_HTTP_TIMEOUT_SECONDS=20
CONNECTED_SOURCE_HTTP_MAX_BYTES=2097152
# Caps one complete source sync, including bounded provider reads and local
# extraction/persistence. Shorter request or shutdown deadlines still win.
CONNECTED_SOURCE_SYNC_TIMEOUT_SECONDS=600
GITHUB_SOURCE_API_BASE_URL=https://api.github.com
GITHUB_SOURCE_TOKEN=
GITHUB_SOURCE_TOKEN_OWNER_IDENTITY=
# Limits each GitHub resource type to a bounded number of 100-record pages.
# HAI fails the sync instead of silently treating a truncated import as complete.
GITHUB_SOURCE_MAX_PAGES=5
# Optional live Trello connector. Use a dedicated Trello token with the read
# scope only. HAI fetches board content through GET requests and never writes
# to Trello. Bind the token to one HAI IDP subject and its Trello member ID.
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_READ_TOKEN=
TRELLO_ACCOUNT_OWNER_IDENTITY=
TRELLO_ACCOUNT_MEMBER_ID=
TRELLO_API_BASE_URL=https://api.trello.com
# Optional signed webhook intake. Set the exact externally registered HTTPS URL.
# HAI validates X-Trello-Webhook and queues read-only reconciliation jobs.
TRELLO_WEBHOOK_CALLBACK_URL=
# WhatsApp exports remain local/import-only. Bound each persisted conversation
# window so long histories do not create unbounded indexing or retrieval work.
WHATSAPP_EXPORT_CHUNK_MESSAGES=40
SOURCE_SCHEDULER_ENABLED=true
SOURCE_SCHEDULER_DURABLE=true
# Fail startup if durable scheduling fails unless this is explicitly enabled.
# The fallback is in-memory only and logs a prominent DEGRADED state.
SOURCE_SCHEDULER_VOLATILE_FALLBACK=false
SOURCE_SCHEDULER_INTERVAL_SECONDS=600
SOURCE_SCHEDULER_RUN_ON_STARTUP=false
# Optional durable manual-sync worker when scheduled syncing is disabled.
# Claims only source.manual_sync; never scans or enables connectors/accounts.
# Requires the router background gate: paused mode or emergency stop defers work.
# A separate owned synthetic harness may use HAI_PHASE2_MODE=autonomous_safe;
# do not unpause a personal installation merely to run acceptance checks.
SOURCE_MANUAL_WORKER_ENABLED=false
# Polling drives durable retries rather than full source scans. These modest
# desktop defaults avoid tight idle loops while keeping recovery responsive.
# Worker poll settings are bounded to 15 seconds through one hour at runtime.
SOURCE_WORKER_POLL_SECONDS=300
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULER_DURABLE=true
WORKFLOW_OPEN_LOOP_SCHEDULER_ENABLED=true
WORKFLOW_SCHEDULER_INTERVAL_SECONDS=600
WORKFLOW_SCHEDULER_RUN_LIMIT=2
WORKFLOW_SCHEDULER_RUN_ON_STARTUP=false
WORKFLOW_CLAIM_LEASE_SECONDS=900
WORKFLOW_WORKER_POLL_SECONDS=300
# Controls due reminder delivery only; approval, emergency-stop, and channel
# policy checks still decide whether any external notification may be delivered.
WORKFLOW_REMINDER_DELIVERY_ENABLED=true

# Revalidate only owner-enabled public catalog metadata. The hourly scheduler
# performs a bounded due check; an entry is due at most once per 24 hours.
HAI_CATALOG_REVALIDATION_ENABLED=true
# These subordinate read-only checks must be explicit as well. They inspect
# fixed public metadata and write only local audit history; neither installs,
# activates, nor executes any discovered project.
HAI_CATALOG_COLLECTION_REVALIDATION_ENABLED=true
HAI_CATALOG_REPOSITORY_DISCOVERY_REVALIDATION_ENABLED=true
HAI_CATALOG_REVALIDATION_INTERVAL_HOURS=24
HAI_CATALOG_REVALIDATION_BATCH_SIZE=8
HAI_CATALOG_REVALIDATION_SCHEDULER_ENABLED=true
HAI_CATALOG_REVALIDATION_SCHEDULER_INTERVAL_MINUTES=60

# Ambient proactive planning. The scheduler creates source-linked proposals by
# default. It cannot execute ready workflows unless the server operator enables
# AMBIENT_EXECUTION_ENABLED; existing approval and emergency-stop gates still apply.
AMBIENT_SCHEDULER_ENABLED=true
AMBIENT_SCHEDULER_DURABLE=true
AMBIENT_EXECUTION_ENABLED=false
AMBIENT_RUN_ON_STARTUP=false
AMBIENT_SCAN_INTERVAL_SECONDS=3600
AMBIENT_MINIMUM_SCORE=35
AMBIENT_MINIMUM_CONFIDENCE=35
AMBIENT_OPPORTUNITY_LIMIT=50
AMBIENT_EXECUTION_LIMIT=3
AMBIENT_DISMISS_COOLDOWN_HOURS=168
AMBIENT_SCAN_RETENTION=100
AMBIENT_WORKER_POLL_SECONDS=300

# Source-backed outcome monitoring is advisory only. It reads fixed local
# ledgers, appends immutable observations/evaluations, and feeds the in-app
# attention inbox; it cannot execute, notify, send, or mutate workflows.
OUTCOME_MONITOR_SCHEDULER_ENABLED=true
OUTCOME_MONITOR_SWEEP_SECONDS=300
OUTCOME_MONITOR_POLL_SECONDS=300
OUTCOME_MONITOR_LEASE_SECONDS=120
OUTCOME_MONITOR_SCOPE_LIMIT=50
OUTCOME_MONITOR_BATCH_LIMIT=20
AUTONOMY_WORLD_STATE_TTL_SECONDS=300
AUTONOMY_TELEMETRY_LIMIT=25

# LLM routing policy. Providers can be replaced with JSON configuration.
LLM_POLICY_JSON=
LLM_PROVIDERS_JSON=
LLM_REQUIRE_RECENT_LIVE_PROBE=false
LLM_PROVIDER_PROBE_MAX_AGE_SECONDS=900
# Bound provider availability probes to 1-30 seconds (default 5), so an
# unavailable provider cannot stall routing or model maintenance.
LLM_PROVIDER_PROBE_TIMEOUT_SECONDS=5
OLLAMA_BASE_URL=
OLLAMA_MODEL_IDS=
# Model Intelligence calls remain blocked unless each direct local model and
# unmetered billing path is personally verified by the operator. Add exact
# provider/model pairs only (for example: ollama/qwen2.5:7b); no wildcards.
# A loopback endpoint or model-list response is not proof of local inference.
HAI_MODEL_INTELLIGENCE_LOCAL_INFERENCE_ATTESTATIONS=
# HAI checks every enabled configured model before use and schedules background
# sweeps from durable per-model due times, with a 24-hour fallback. The durable
# per-model gate is fixed to one check per 24 hours. Ollama
# model tags may be pulled; all other runtimes are probe-only and are never
# silently upgraded. A failed check blocks that model and retries after 5 minutes.
LLM_MODEL_MAINTENANCE_ENABLED=true
LLM_MODEL_MAINTENANCE_INTERVAL_HOURS=24
LLM_MODEL_MAINTENANCE_TIMEOUT_SECONDS=900
LLM_MODEL_MAINTENANCE_FAILURE_RETRY_MINUTES=5
LLM_MODEL_MAINTENANCE_SCHEDULER_ENABLED=true
LM_STUDIO_BASE_URL=
LM_STUDIO_MODEL_ID=local-model
# llama.cpp must remain local: use http://host.docker.internal:<port> when HAI
# runs in Docker and llama-server runs on Windows, or a loopback address when
# both run on the same host. The provider remains inactive until /v1/models
# returns a successful probe.
LLAMA_CPP_BASE_URL=
LLAMA_CPP_MODEL_ID=local-model
# LocalAI is an optional operator-installed local server. HAI accepts only a
# loopback or host.docker.internal endpoint, does not download models, and
# keeps the profile inactive until /v1/models passes a live probe.
LOCALAI_BASE_URL=
LOCALAI_MODEL_ID=localai-default
# vLLM is an optional operator-installed local model server. HAI accepts only
# a loopback or host.docker.internal endpoint and keeps the profile inactive
# until /v1/models passes a live probe. Configure a model explicitly; HAI does
# not download or start it.
VLLM_BASE_URL=
VLLM_MODEL_ID=vllm-default
# SGLang and DSpark are optional operator-installed local OpenAI-compatible
# servers. They remain disabled until a loopback/host.docker.internal endpoint
# and explicit model identifier are configured and pass a live probe.
SGLANG_BASE_URL=
SGLANG_MODEL_ID=sglang-default
DSPARK_ENABLED=false
DSPARK_BASE_URL=
DSPARK_PROBE_PATH=/v1/models
DSPARK_GENERATION_PATH=/v1/chat/completions
DSPARK_MODEL_ID=dspark-default
# mistral.rs is an optional operator-installed local OpenAI-compatible server.
# HAI calls only /v1/models and /v1/chat/completions, never its UI, agent,
# shell, web, file, MCP, Skills, or code-execution surfaces. Use a loopback or
# host.docker.internal endpoint and start mistralrs without agentic tools.
MISTRAL_RS_BASE_URL=
MISTRAL_RS_MODEL_ID=mistralrs-default
# LiteLLM is an optional, operator-installed local proxy. HAI only accepts a
# loopback or host.docker.internal endpoint and requires a LiteLLM virtual key.
# HAI cannot verify the proxy's upstream model billing, so every generation
# through this gateway remains manually approval-gated.
LITELLM_ENABLED=false
LITELLM_BASE_URL=
LITELLM_MODEL_ID=local-model
LITELLM_API_KEY=
# Local semantic retrieval is opt-in. HAI sends only source-extraction text and
# editable context-memory text to this loopback/host.docker.internal
# OpenAI-compatible embedding endpoint, stores vectors in the local
# pgvector-enabled automation database, and falls back to keyword retrieval if
# the endpoint is unavailable. Do not use a cloud URL.
HAI_SEMANTIC_RETRIEVAL_ENABLED=false
HAI_EMBEDDING_BASE_URL=
HAI_EMBEDDING_MODEL=
HAI_EMBEDDING_API_KEY=
HAI_EMBEDDING_INPUT_LIMIT=12000
HAI_EMBEDDING_TIMEOUT_SECONDS=10
# Opt-in local OR-Tools proposal solver. It accepts only opaque task IDs, time
# windows, durations, and priorities, then returns an audited proposal. It
# never writes to workflows, calendars, files, tools, or external services.
HAI_PLANNING_OPTIMIZER_ENABLED=false
HAI_PLANNING_OPTIMIZER_BASE_URL=http://ortools-solver:8080
HAI_PLANNING_OPTIMIZER_TIMEOUT_SECONDS=5
HAI_PLANNING_OPTIMIZER_MAX_SOLVE_SECONDS=2
ODYSSEUS_BASE_URL=
ODYSSEUS_API_TOKEN=
# Runtime Lab performs bounded, schema-validated discovery only. Discovery
# never grants model, tool, host, or external-effect authority. Only hosts named
# here can be probed; add a remote hostname deliberately after endpoint review.
# Production OpenClaw inspection uses the canonical OPENCLAW_GATEWAY_* settings
# below. OPENCLAW_BASE_URL remains only for isolated Runtime Lab local tooling
# and backwards-compatible tests; it is not used by the production router.
RUNTIME_LAB_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,hermes,openclaw,odysseus,openhands
HERMES_BASE_URL=
HERMES_HEALTH_PATH=/health
# Optional. When set, Runtime Lab also validates Hermes /v1/capabilities with a
# Bearer token. The token is never returned through HAI APIs or logs.
HERMES_API_SERVER_KEY=
OPENCLAW_BASE_URL=
OPENCLAW_HEALTH_PATH=/health
ODYSSEUS_HEALTH_PATH=/api/health
# Optional OpenHands Agent Canvas/Agent Server health endpoint. HAI only uses
# the configured GET health route; it cannot start agents, read workspaces, or
# call tools through this Runtime Lab adapter.
OPENHANDS_BASE_URL=
OPENHANDS_HEALTH_PATH=/health
NOUS_PORTAL_BASE_URL=
NOUS_PORTAL_API_KEY=
MIXTURE_OF_AGENTS_BASE_URL=
MIXTURE_OF_AGENTS_API_KEY=
OPENAI_CODEX_BASE_URL=
OPENAI_CODEX_API_KEY=
# Controlled external agent runtimes are disabled by default. Enabling a
# runtime still does not bypass HAI approval, emergency-stop, verification,
# host allowlist, timeout, or audit controls.
AGENT_RUNTIME_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,odysseus,openclaw
AGENT_RUNTIME_OUTPUT_LIMIT_BYTES=65536
AGENT_RUNTIME_WORKSPACE_ROOT=/root/agent-workspaces
ODYSSEUS_AGENT_ENABLED=false
# Create/select this session in Odysseus first. HAI will not create a session
# using an arbitrary model endpoint on the operator's behalf.
ODYSSEUS_AGENT_SESSION_ID=
ODYSSEUS_AGENT_WORKSPACE=
ODYSSEUS_AGENT_TIMEOUT_SECONDS=120
# Odysseus ecosystem visibility and execution flags. Keep high-risk execution
# surfaces disabled until the matching HAI approval and audit flow is verified.
ODYSSEUS_CODEX_BRIDGE_ENABLED=true
ODYSSEUS_CLAUDE_BRIDGE_ENABLED=false
ODYSSEUS_TODOS_ENABLED=false
ODYSSEUS_NOTES_ENABLED=false
ODYSSEUS_TASKS_ENABLED=false
ODYSSEUS_EMAIL_ENABLED=false
ODYSSEUS_CALENDAR_ENABLED=false
ODYSSEUS_CONTACTS_ENABLED=false
ODYSSEUS_DOCUMENTS_ENABLED=false
ODYSSEUS_MEMORY_SYNC_ENABLED=false
ODYSSEUS_RESEARCH_ENABLED=false
ODYSSEUS_SEARCH_ENABLED=false
ODYSSEUS_MCP_ENABLED=false
ODYSSEUS_COOKBOOK_ENABLED=false
ODYSSEUS_LOCAL_MODEL_DISCOVERY_ENABLED=false
ODYSSEUS_SHELL_ENABLED=false
ODYSSEUS_BROWSER_ENABLED=false
ODYSSEUS_VAULT_ENABLED=false
ODYSSEUS_GALLERY_ENABLED=false
ODYSSEUS_TTS_ENABLED=false
ODYSSEUS_STT_ENABLED=false
ODYSSEUS_COMPANION_ENABLED=false
ODYSSEUS_WEBHOOKS_ENABLED=false
ODYSSEUS_AGENT_MIGRATION_ENABLED=false
ODYSSEUS_CONTEXT_BUDGET_ENABLED=false
ODYSSEUS_AGENT_ALLOW_BASH=false
ODYSSEUS_AGENT_ALLOW_WEB_SEARCH=false
ODYSSEUS_AGENT_ALLOW_RESEARCH=false
HERMES_AGENT_ENABLED=false
HERMES_EXECUTABLE=hermes
# Optional Hermes data/profile scope. Use this when HAI should run Hermes
# against a dedicated profile instead of the operator's default Hermes home.
HERMES_HOME=
HERMES_PROFILE=
HERMES_IGNORE_USER_CONFIG=false
# This must be a dedicated folder that Hermes may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
HERMES_WORKSPACE=/root/agent-workspaces/hermes
HERMES_MAX_TURNS=20
HERMES_TIMEOUT_SECONDS=120
# Optional comma-separated Hermes toolsets and skills. Leave empty to let the
# configured Hermes profile decide. Prefer restrictive toolsets such as safe,
# web, file, skills, todo, or explicitly reviewed custom bundles.
HERMES_TOOLSETS=
HERMES_SKILLS=
# Ecosystem visibility flags. These do not bypass HAI approvals; they tell the
# runtime registry which Hermes surfaces are intentionally part of this HAI node.
HERMES_GATEWAY_ENABLED=false
HERMES_CRON_ENABLED=false
HERMES_MCP_ENABLED=false
HERMES_MOA_ENABLED=false
HERMES_SUBAGENTS_ENABLED=false
HERMES_MEMORY_SYNC_ENABLED=false
HERMES_ACP_ENABLED=false
HERMES_TERMINAL_BACKENDS=local,docker,ssh,singularity,modal,daytona
# Add only the credential/config variable names Hermes needs. Values are
# inherited at runtime but are never returned through the registry API.
HERMES_ENV_ALLOWLIST=
# DeepSeek Harness is integrated as an HAI architecture/runtime adapter only.
# Production task execution is hard-disabled until both authenticated bridge
# transport (TLS peer identity/pinning; HTTP loopback impersonation is unresolved)
# and a real OS-enforced least-privilege sandbox exist and pass target-host tests.
# Keep these switches false: setting them true does not override the code gate.
DEEPSEEK_HARNESS_ENABLED=false
DEEPSEEK_HARNESS_EXECUTION_ENABLED=false
DEEPSEEK_HARNESS_EXECUTABLE=dsh
# Reserved version metadata for future reviewed acceptance; it cannot enable
# execution while the transport and sandbox gates above are unmet.
DEEPSEEK_HARNESS_VERSION=
# Reserved workspace metadata for a future reviewed host integration. It is an
# identifier only; HAI never receives the host filesystem path.
DEEPSEEK_HARNESS_WORKSPACE_KEY=deepseek-harness
DEEPSEEK_HARNESS_WORKSPACE=/root/agent-workspaces/deepseek-harness
DEEPSEEK_HARNESS_STATE_DIR=/root/agent-workspaces/deepseek-harness/.dsh-state
DEEPSEEK_HARNESS_TIMEOUT_SECONDS=120
# Reserved future child-environment allowlist. No DSH process is launched while
# the hard gate is active; do not add provider credentials here now.
DEEPSEEK_HARNESS_ENV_ALLOWLIST=
# Reserved Windows-host bridge settings. Production bridge entry points are
# hard-disabled; do not enable this, start the profile, or supply a token as a
# workaround. The current HTTP loopback transport cannot authenticate the HAI
# gateway to the worker; a loopback-only port is not a trusted peer identity.
HAI_HOST_RUNTIME_BRIDGE_ENABLED=false
HAI_HOST_RUNTIME_BRIDGE_TOKEN=
HAI_HOST_RUNTIME_BRIDGE_WORKER_ID=windows-dsh
HAI_HOST_RUNTIME_BRIDGE_PORT=8092
HAI_HOST_RUNTIME_BRIDGE_URL=http://127.0.0.1:8092
# Reserved lease duration for a future reviewed bridge implementation. This
# value does not create, lease, or enable DSH work while the hard gate is active.
HAI_HOST_RUNTIME_LEASE_SECONDS=1200
# Existing host-runtime reconciliation is audit projection only. It does not
# execute commands or turn a process exit into verified task completion.
HAI_HOST_RUNTIME_RECONCILIATION_ENABLED=true
HAI_HOST_RUNTIME_RECONCILIATION_SECONDS=30
HAI_HOST_RUNTIME_RECONCILIATION_POLL_SECONDS=10
HAI_HOST_RUNTIME_RECONCILIATION_BATCH=20
OPENCLAW_AGENT_ENABLED=false
OPENCLAW_EXECUTABLE=openclaw
# Optional local Gateway URL. The Windows OpenClaw Companion installs an
# isolated WSL gateway on host loopback. For a Compose backend, enabling the
# Gateway and setting this exact URL, explicit port, and verified IP pins is
# the narrow opt-in:
# ws://host.docker.internal:18789
# host.docker.internal must be an exact entry in AGENT_RUNTIME_ALLOWED_HOSTS.
# HAI then permits only pinned private unicast DNS answers for that host and
# dials only the configured URL/port. This explicitly trusted Docker host
# alias is the sole non-loopback plaintext exception; remote ws/http endpoints
# remain blocked. Do not expose the Companion endpoint outside the local host.
#
# A health-only Companion connection needs OPENCLAW_AGENT_ENABLED=true and
# OPENCLAW_GATEWAY_ENABLED=true. HAI converts ws/wss to an unauthenticated
# GET /health probe, refuses redirects and credential-bearing URLs, and accepts
# only {"ok":true,"status":"live"}. It does not send the gateway token or
# execute an OpenClaw task. CLI execution still needs a separate approved
# workspace and runtime configuration; a token is required only for the
# authenticated operator.read discovery option below.
OPENCLAW_GATEWAY_URL=
# For host.docker.internal only: operator-verified private IPv4/IPv6 addresses,
# comma separated. Every DNS answer must match a pin; address changes require
# operator review. Empty disables the Docker-host exception.
OPENCLAW_GATEWAY_DOCKER_HOST_IPS=
# Optional, still read-only protocol validation after the health probe. HAI
# opens the configured WebSocket, reads exactly one bounded connect.challenge,
# then closes it. It never sends a token, authentication, a connect frame, an
# RPC, or a task through this setting.
OPENCLAW_GATEWAY_PROTOCOL_DISCOVERY_ENABLED=false
# Optional authenticated, read-only Gateway identity check. This additionally
# needs OPENCLAW_GATEWAY_TOKEN. HAI opens one bounded socket, reads the challenge,
# sends only a protocol `connect` request for exactly `operator.read`, validates
# the returned `hello-ok` scope and policy, then closes. It sends no Gateway RPC,
# task, tool, message, browser, node, or channel command and never makes the
# runtime executable. Keep disabled until the current Companion accepts this
# handshake with a deliberately configured token.
OPENCLAW_GATEWAY_AUTH_DISCOVERY_ENABLED=false
# Optional authenticated, read-only task-ledger summary. This is disabled by
# default and requires OPENCLAW_GATEWAY_AUTH_DISCOVERY_ENABLED=true plus a
# configured token. HAI sends one `tasks.list` RPC with limit 50, retains only
# aggregate status counts for the current health response, then closes. It
# never returns task IDs, titles, prompts, owner data, errors, or credentials,
# and cannot cancel, start, or modify a task.
OPENCLAW_GATEWAY_TASK_LEDGER_DISCOVERY_ENABLED=false
# Optional authenticated, read-only capability summary. This is disabled by
# default and requires OPENCLAW_GATEWAY_AUTH_DISCOVERY_ENABLED=true plus a
# configured token. HAI requires `skills.status`, `tools.catalog`, and
# `commands.list` to be advertised. It sends the first two RPCs with empty
# parameters and `commands.list` with `includeArgs=false`, then retains only
# skill and command counts plus `core`/`plugin` tool counts. It discards names,
# descriptions, plugin IDs, arguments, raw responses, and all credentials. It
# cannot install, update, invoke, configure, or otherwise operate on an
# OpenClaw capability.
OPENCLAW_GATEWAY_CAPABILITY_DISCOVERY_ENABLED=false
# Optional authenticated, read-only prepared model availability summary. This
# requires OPENCLAW_GATEWAY_AUTH_DISCOVERY_ENABLED=true and a configured token.
# HAI requires `models.list`, sends only `view=configured` with
# `preparedOnly=true`, and retains only available/unavailable/unknown counts.
# It never triggers provider discovery, selects or routes a model, refreshes a
# catalog, changes a provider, downloads a model, or exposes model/provider IDs.
OPENCLAW_GATEWAY_MODEL_CATALOG_DISCOVERY_ENABLED=false
# Optional authenticated, read-only agent-roster summary. This requires
# OPENCLAW_GATEWAY_AUTH_DISCOVERY_ENABLED=true and a configured token. HAI
# requests the `agent-kind` client capability and sends only `agents.list {}`.
# It retains only agent/system/legacy aggregate counts: no IDs, labels, models,
# workspace paths, creation provenance, or raw payloads. It cannot create,
# update, delete, bind, or execute an OpenClaw agent.
OPENCLAW_GATEWAY_AGENT_ROSTER_DISCOVERY_ENABLED=false
# Reserved, default-off delegated-session switch. Setting this does not make
# new session creation executable: HAI currently fails closed because the
# shared-secret Gateway handshake cannot prove the authenticated durable
# creator identity, sandbox-required role, and effective policy for the exact
# run. Implement and validate that identity-bound attestation before enabling
# delegated work. Existing owner-bound receipts can still be reconciled or
# stopped only by exact run identity; no session-wide cancellation is used.
OPENCLAW_GATEWAY_DELEGATION_ENABLED=false
OPENCLAW_GATEWAY_DELEGATION_TOKEN=
# Exact provider/model references allowed for an automation's runtimeModel.
# Empty keeps existing defaults; it does not authorize a new model override.
OPENCLAW_GATEWAY_ALLOWED_MODELS=
# Optional terminal artifact metadata handoff. This is disabled by default and
# uses only OPENCLAW_GATEWAY_TOKEN with operator.read; it never reuses the
# delegation write token. HAI calls only artifacts.list for the privately
# stored run ID after a source-backed completed observation. It persists a
# one-way digest, type, MIME type, and byte count only: no artifact ID, title,
# source, URL, transcript, or content is stored by the metadata worker. Separate
# owner-initiated content requests can use artifacts.download while enabled.
OPENCLAW_GATEWAY_ARTIFACT_IMPORT_ENABLED=false
# Optional exact origins for owner-initiated URL downloads, comma-separated.
# Empty denies URL mode. Example: https://files.example.com
# No wildcard, credentials, path, query, redirects, proxy or forwarded tokens.
# HTTPS required except explicit loopback HTTP. Hostnames must resolve publicly;
# local/private services require an explicit literal IP origin (or localhost).
# Link-local, metadata and reserved address ranges are always blocked.
OPENCLAW_ARTIFACT_DOWNLOAD_ORIGINS=
# Optional dedicated secret for encrypted, explicit owner-requested file retention.
# Keep the key bytes unchanged so existing retained files remain decryptable.
# New writes require OPENCLAW_ARTIFACT_RETENTION_KEY_CONFIRMED=true after the
# operator verifies this value was generated by a cryptographically secure RNG.
# HAI rejects obvious low-diversity placeholders, but cannot prove key entropy.
# Back up this key with the database: changing it does not re-encrypt existing files.
# Empty disables retention. Limit: 64 MiB / 128 files per owner, 8 MiB per file.
OPENCLAW_ARTIFACT_RETENTION_KEY=
OPENCLAW_ARTIFACT_RETENTION_KEY_CONFIRMED=false
# Defaults to the delegation switch. Set false to pause observation without
# altering any Gateway session. Values are bounded to protect the durable queue.
# Nonterminal or inaccessible sessions older than the stale window become a
# HAI review item; they are never guessed as successful or failed.
HAI_OPENCLAW_GATEWAY_RECONCILIATION_ENABLED=
HAI_OPENCLAW_GATEWAY_RECONCILIATION_SECONDS=30
HAI_OPENCLAW_GATEWAY_RECONCILIATION_POLL_SECONDS=10
HAI_OPENCLAW_GATEWAY_RECONCILIATION_BATCH=20
HAI_OPENCLAW_GATEWAY_RECONCILIATION_STALE_SECONDS=900
# Keep this empty for a health-only Companion connection. Do not put secrets in
# OPENCLAW_GATEWAY_URL; task execution reads this value only after all HAI
# approval and final-effect gates have passed.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_STATE_DIR=
OPENCLAW_CONFIG_PATH=
# Optional read-only ecosystem inventory source. This may point at an extracted
# OpenClaw repository/package or at openclaw-main.zip. HAI lists skills, skill
# scripts, root scripts, extensions, providers, channels, apps, packages, source
# modules, docs, QA/test assets, config profiles, security assets, deployment
# descriptors, prompt maps, GitHub workflows, repository docs/config, and
# control UI/controller modules from it, but does not run scripts, import code,
# or dispatch upstream automations from this path.
OPENCLAW_ECOSYSTEM_PATH=
# Comma-separated roots that may contain the optional read-only ecosystem
# inventory. Never permit a profile root, drive root, or broad user directory.
OPENCLAW_ECOSYSTEM_ALLOWED_ROOTS=
# This must be a dedicated folder that OpenClaw may inspect or modify. Do not
# point it at an entire user profile or unrestricted filesystem root.
OPENCLAW_WORKSPACE=/root/agent-workspaces/openclaw
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_THINKING=high
OPENCLAW_ENV_ALLOWLIST=
# Legacy direct CLI task execution is fail-closed until HAI can verify the
# effective OpenClaw policy bound to the exact run. Do not enable as a workaround.
OPENCLAW_AGENT_CLI_ENABLED=false
# Verified OpenClaw release maintenance is enabled by default on Windows.
# The Windows initializer creates a dedicated random token. Without a valid
# token or a running, correctly configured worker, HAI cannot authorize installs.
# Set false to explicitly opt out; this does not grant agent/tool execution.
HAI_OPENCLAW_MAINTENANCE_ENABLED=true
HAI_OPENCLAW_MAINTENANCE_TOKEN=
# Host worker only; use the loopback backend port, not an Internet-facing gateway.
HAI_OPENCLAW_MAINTENANCE_URL=http://127.0.0.1:17070
# Host worker only: Authenticode signer thumbprint reviewed by the operator.
HAI_OPENCLAW_PUBLISHER_THUMBPRINT=
OPENCLAW_GATEWAY_ENABLED=false
OPENCLAW_MESSAGES_ENABLED=false
OPENCLAW_SKILLS_ENABLED=false
OPENCLAW_PLUGINS_ENABLED=false
OPENCLAW_MCP_ENABLED=false
OPENCLAW_MEMORY_ENABLED=false
OPENCLAW_CRON_ENABLED=false
OPENCLAW_BROWSER_ENABLED=false
OPENCLAW_CANVAS_ENABLED=false
OPENCLAW_NODES_ENABLED=false
OPENCLAW_VOICE_ENABLED=false
OPENCLAW_TALK_ENABLED=false
OPENCLAW_WEBCHAT_ENABLED=false
OPENCLAW_PAIRING_ENABLED=false
OPENCLAW_EXEC_APPROVALS_ENABLED=false
OPENCLAW_HOST_TOOLS_ENABLED=false
OPENCLAW_PUBLIC_POSTING_ENABLED=false
OPENCLAW_WEB_SEARCH_ENABLED=false
OPENCLAW_MULTI_AGENT_ENABLED=false
OPENCLAW_APP_SDK_ENABLED=false
OPENCLAW_PLUGIN_SDK_ENABLED=false
OPENCLAW_LOCAL_MODELS_ENABLED=false
OPENCLAW_ALLOW_HIGH_RISK_EXECUTION=false
OPENCLAW_SANDBOX_REQUIRED=true
OPENCLAW_SANDBOX_MODE=all
OPENCLAW_SANDBOX_DOCKER_ENABLED=false
OPENCLAW_SANDBOX_SSH_ENABLED=false
OPENCLAW_SANDBOX_OPENSHELL_ENABLED=false
OPENCLAW_CHANNELS_ENABLED=
OPENCLAW_PROVIDERS_ENABLED=
OPENCLAW_COMPANION_APPS=windows,macos,ios,android
FREE_CLOUD_OPENAI_BASE_URL=
FREE_CLOUD_API_KEY=
LLM_GENERATION_TIMEOUT_SECONDS=60
LLM_ALLOW_LINK_LOCAL_ENDPOINTS=false
# DualPath is only meaningful for disaggregated LLM serving with separate
# prefill/decode engines, shared KV-cache storage, a compute transfer network,
# and a compatible global scheduler. Keep disabled for ordinary Ollama/LM Studio.
LLM_KV_CACHE_LOAD_STRATEGY=disabled
LLM_DUALPATH_INFRASTRUCTURE_VERIFIED=false

# Optional read-only MCP preflight. This is not an MCP execution adapter: it
# can only initialize explicitly configured local Streamable HTTP servers and
# list tools. No credentials, arbitrary URLs, process spawning, or tool calls
# are supported here. Format: id@reviewed-catalog-profile=http://host.docker.internal:3001/mcp;...
# The catalog profile must be an eligible MCP capability, for example
# mcp-inspector, fastmcp, github-mcp-server, playwright-mcp, or
# google-genai-toolbox.
HAI_MCP_PREFLIGHT_ENABLED=false
HAI_MCP_PREFLIGHT_SERVERS=
HAI_MCP_PREFLIGHT_TIMEOUT_SECONDS=5

# Optional local Temporal durability bridge. Enable only together with
# `docker compose --profile durability up --build`. The worker can create
# governed HAI follow-up proposals; it cannot send messages or bypass approval.
HAI_TEMPORAL_ENABLED=false
HAI_TEMPORAL_ADDRESS=temporal:7233
HAI_TEMPORAL_NAMESPACE=default
HAI_TEMPORAL_TASK_QUEUE=hai-governed-follow-up
# Use a long random local-only password before enabling the durability profile.
HAI_TEMPORAL_POSTGRES_PASSWORD=change-me-temporal-local-only

# Optional Playwright-backed local verification worker. This is a named,
# read-only verifier, not a browser agent: every profile must target a local
# origin and it cannot click, submit, download, retain cookies, or use public URLs.
HAI_PLAYWRIGHT_ENABLED=false
HAI_PLAYWRIGHT_RUNNER_URL=http://browser-verifier:8080
HAI_PLAYWRIGHT_RUNNER_TOKEN=change-me-browser-verifier-local-only
HAI_PLAYWRIGHT_PROFILES='[{"id":"hai-login","name":"HAI login route","url":"http://frontend/login","expectedPath":"/login"}]'
HAI_PLAYWRIGHT_ALLOWED_ORIGINS=http://frontend,http://localhost,http://127.0.0.1

# Optional local SearXNG discovery. Keep disabled unless a local instance is
# configured. Generate a unique secret before starting the bundled profile.
HAI_SEARXNG_ENABLED=false
HAI_SEARXNG_BASE_URL=http://host.docker.internal:8080
HAI_SEARXNG_SECRET=replace-with-a-unique-local-secret

# Optional local RAGFlow evidence retrieval. HAI can query only the fixed
# dataset IDs below; it never uploads, deletes, invokes RAGFlow agents/code,
# or converts returned chunks directly into memory or facts. Set the base URL
# only after mapping RAGFlow's HTTP port to an explicit non-HAI host port.
HAI_RAGFLOW_ENABLED=false
HAI_RAGFLOW_BASE_URL=
HAI_RAGFLOW_API_KEY=
HAI_RAGFLOW_DATASET_IDS=

# Optional local AnythingLLM candidate-evidence retrieval. HAI uses only the
# documented vector-search endpoint for the fixed workspace slugs below. It
# never opens workspace chat, sends attachments, reads history, or changes
# documents/settings. The upstream vector search uses the workspace embedding
# provider, so set the confirmation only after verifying it is local.
HAI_ANYTHINGLLM_ENABLED=false
HAI_ANYTHINGLLM_BASE_URL=http://host.docker.internal:3001
HAI_ANYTHINGLLM_API_KEY=
HAI_ANYTHINGLLM_WORKSPACE_SLUGS=
HAI_ANYTHINGLLM_LOCAL_EMBEDDINGS_CONFIRMED=false

# Optional read-only Serena semantic code-context bridge. Start Serena outside
# HAI in Streamable HTTP mode and pin it to exactly one reviewed project. HAI
# never launches it, changes project, forwards credentials, or calls any tool
# except find_symbol with source body and hover information disabled.
HAI_SERENA_ENABLED=false
HAI_SERENA_BASE_URL=http://host.docker.internal:9121/mcp
HAI_SERENA_PROJECT_ID=

# Optional Odoo JSON-2 source ingestion. Configure one operator-owned Odoo
# instance and a read-only API key. HAI only calls search_read on the fixed
# allowlist below and never writes back, calls generic RPC methods, or stores
# this API key in source records or audit logs.
HAI_ODOO_ENABLED=false
HAI_ODOO_BASE_URL=
HAI_ODOO_DATABASE=
HAI_ODOO_API_KEY=
HAI_ODOO_ALLOWED_MODELS=crm.lead,project.task
HAI_ODOO_SYNC_LIMIT=20

# Optional read-only ShareT link inventory. Create a connector:read token in
# ShareT and store it only here. The adapter follows every API page up to the
# explicit completeness limit, excludes participant email addresses, and has
# no create, update, comment, or revoke code path.
HAI_SHARET_ENABLED=false
HAI_SHARET_BASE_URL=
HAI_SHARET_CONNECTOR_TOKEN=
HAI_SHARET_SYNC_LIMIT=1000

# Optional local Airbyte source/connection inventory. Set this only for an
# operator-hosted Airbyte API and explicit workspace UUID allowlist. HAI reads
# one bounded page of source and connection metadata only; it never reads
# connector configuration/credentials/records, starts syncs, or writes back.
HAI_AIRBYTE_ENABLED=false
HAI_AIRBYTE_BASE_URL=http://host.docker.internal:8000/api/v1
HAI_AIRBYTE_API_KEY=
HAI_AIRBYTE_WORKSPACE_IDS=

# Read-only LARO case-intelligence connector. Create the bearer credential in
# LARO Settings > HAI; never place it in a connected source URL or database row.
HAI_LARO_ENABLED=false
# Required only when HAI_LARO_ENABLED=true. Use your reviewed HTTPS LARO origin
# (or a local LARO runtime); no remote endpoint is selected by default.
HAI_LARO_BASE_URL=
HAI_LARO_CONNECTOR_TOKEN=
HAI_LARO_SYNC_LIMIT=50

# Read-only worker dashboard commitment and reminder feed. Create and rotate
# the key in Worker Control Settings > Integration & Automation > HAI.
HAI_WORKER_CONTROL_ENABLED=false
HAI_WORKER_CONTROL_BASE_URL=http://host.docker.internal:3025
HAI_WORKER_CONTROL_CONNECTOR_TOKEN=
HAI_WORKER_CONTROL_SYNC_LIMIT=50

# Optional local CloudQuery sync-summary intake. Run CloudQuery separately and
# configure its `--summary-location` to emit one reviewed JSONL file inside the
# host directory below. HAI mounts that directory read-only, reads only newline-
# terminated summary records, and never runs CloudQuery, reads its config or
# credentials, or accesses the CloudQuery source/destination data.
HAI_CLOUDQUERY_SUMMARY_ENABLED=false
CLOUDQUERY_SUMMARY_HOST_DIR=./cloudquery-summary
HAI_CLOUDQUERY_ALLOWED_ROOT=/cloudquery-summary
HAI_CLOUDQUERY_SUMMARY_PATH=/cloudquery-summary/summary.jsonl
HAI_CLOUDQUERY_MAX_ENTRIES=50

# Optional local Presidio Analyzer second-pass PII detection. The bridge sends
# a bounded, user-submitted text value only to the local endpoint, returns
# entity metadata without the source text, and never treats no detections as
# proof that cloud, memory, or external-action use is safe. It does not
# anonymize, mask, delete, or persist content.
HAI_PRESIDIO_ENABLED=false
HAI_PRESIDIO_BASE_URL=http://host.docker.internal:3000
HAI_PRESIDIO_LANGUAGE=en
HAI_PRESIDIO_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,PERSON,LOCATION,IBAN_CODE,CREDIT_CARD

# Optional local Evidently evaluation runner. It accepts only small synthetic
# or already-redacted fixtures, rejects detected PII and secrets before sending,
# and returns report metadata only. It cannot call providers, export data,
# change routing or policy, verify work, or trigger any execution.
HAI_EVIDENTLY_ENABLED=false
HAI_EVIDENTLY_BASE_URL=http://evidently-runner:8080
HAI_EVIDENTLY_TIMEOUT_SECONDS=8

# Optional local Guardrails AI fixed-schema validator. Enable only with
# `docker compose --profile validation up --build`. It validates one bounded,
# redacted action-proposal JSON contract and returns review metadata only; it
# cannot call a model, fetch Hub validators, authorize, persist, or execute.
HAI_GUARDRAILS_ENABLED=false
HAI_GUARDRAILS_BASE_URL=http://guardrails-runner:8080
HAI_GUARDRAILS_TIMEOUT_SECONDS=8

# Optional local PydanticAI typed-planning runner. Enable only with
# `docker compose --profile typed-planning up --build` after configuring an
# operator-reviewed loopback OpenAI-compatible endpoint and model. It returns
# one bounded schema-validated planning draft only: it has no tools, memory,
# source access, provider selection, retry loop, persistence, approval, or
# execution authority. HAI validates the draft separately before use.
HAI_PYDANTIC_AI_ENABLED=false
HAI_PYDANTIC_AI_BASE_URL=http://pydantic-ai-runner:8080
HAI_PYDANTIC_AI_TIMEOUT_SECONDS=20
HAI_PYDANTIC_AI_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
HAI_PYDANTIC_AI_LOCAL_MODEL_ID=
HAI_PYDANTIC_AI_LOCAL_API_KEY=

# Optional FastMCP local read-only context bridge. Enable only with
# `docker compose --profile mcp-bridge up --build`. Generate two different
# local-only 32+ character tokens: the bridge token is used only between the
# FastMCP container and HAI; the client token is supplied only to the approved
# local MCP client at http://127.0.0.1:${HAI_FASTMCP_PORT}/mcp. The bridge gives
# that client only aggregate and bounded actionable workflow summaries for the
# explicit owner. It has no write, source, memory, policy, approval, or runtime
# capability and HAI never receives the client token.
HAI_FASTMCP_BRIDGE_ENABLED=false
HAI_FASTMCP_BRIDGE_OWNER_ID=
HAI_FASTMCP_BRIDGE_TOKEN=
HAI_FASTMCP_CLIENT_TOKEN=
HAI_FASTMCP_PORT=8090
HAI_FASTMCP_BRIDGE_API_BASE_URL=http://backend:8080/api/v1/mcp-agent

# Optional local A2A planning bridge. It implements a small authenticated A2A
# 1.0-shaped profile for one peer: JSON-RPC `SendMessage` returns a
# non-executable planning draft. It is not a full A2A task-lifecycle server.
# Use a unique local-only 32+ character token and a named HAI owner. The URL
# must be loopback, host.docker.internal, gateway, or a private-network IP.
# It does not create tasks, refresh sources, persist plans, request approval,
# execute tools, reveal source/memory context, or discover other agents.
# New installs keep this disabled. Opt in with -EnableA2ABridge during first-run
# initialization or explicitly enable it in the local HAI environment file.
HAI_A2A_BRIDGE_ENABLED=false
HAI_A2A_BRIDGE_OWNER_ID=
HAI_A2A_BRIDGE_TOKEN=
# The local bridge is published by the optional, loopback-only a2a-gateway
# Compose profile. It is intentionally separate from the dashboard gateway.
HAI_A2A_LOCAL_PORT=8091
HAI_A2A_BRIDGE_URL=http://127.0.0.1:8091/api/v1/a2a
# A public ngrok tunnel must never advertise the local-only A2A planning bridge.
HAI_A2A_BRIDGE_PUBLIC_NGROK_ENABLED=false

# Optional public HTTPS access. This stays disabled unless the cloud-tunnel
# profile is selected. Use a dedicated ngrok authtoken and a reserved HTTPS
# domain, then validate before starting with .\scripts\start-ngrok.ps1
# -ValidateOnly. The loopback gateway remains the only host-published port.
NGROK_AUTHTOKEN=
HAI_NGROK_URL=https://your-reserved-domain.ngrok.app

# Optional local LM Evaluation Harness runner. Enable only with
# `docker compose --profile model-evaluation up --build` after configuring one
# operator-reviewed local model endpoint. The fixed suite has six synthetic
# cases and returns aggregate metadata only; it cannot change routing, policy,
# budget, verification, memory, workflow, or execution behavior.
HAI_LM_EVAL_ENABLED=false
HAI_LM_EVAL_BASE_URL=http://lm-eval-runner:8080
HAI_LM_EVAL_TIMEOUT_SECONDS=130
HAI_LM_EVAL_MODEL_ID=
HAI_LM_EVAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1

# Optional local Promptfoo safety-regression runner. Enable only with
# `docker compose --profile safety-evaluation up --build` after configuring one
# operator-reviewed local OpenAI-compatible endpoint. It runs one shipped,
# synthetic six-case suite and returns aggregate pass/fail metadata only. It
# cannot use real sources, accept caller prompts or providers, change routing,
# policy, verification, memory, workflow, approvals, or execution behavior.
HAI_PROMPTFOO_ENABLED=false
HAI_PROMPTFOO_BASE_URL=http://promptfoo-runner:8080
HAI_PROMPTFOO_TIMEOUT_SECONDS=130
HAI_PROMPTFOO_MODEL_ID=
HAI_PROMPTFOO_MODEL_BASE_URL=http://host.docker.internal:11434/v1

# Optional local DeepTeam agentic-safety regression runner. Enable only with
# `docker compose --profile deepteam-evaluation up --build` after configuring
# one operator-reviewed local OpenAI-compatible endpoint. It evaluates a fixed
# synthetic refusal target with two agentic/data-safety vulnerabilities and one
# bounded prompt-injection method, then returns aggregate metadata only. It
# never reads HAI data, targets real HAI behavior, accepts caller inputs, or
# changes routing, policy, verification, memory, workflow, approvals, or execution.
HAI_DEEPTEAM_ENABLED=false
HAI_DEEPTEAM_BASE_URL=http://deepteam-runner:8080
HAI_DEEPTEAM_TIMEOUT_SECONDS=180
HAI_DEEPTEAM_MODEL_ID=
HAI_DEEPTEAM_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_DEEPTEAM_MODEL_API_KEY=

# Optional local DeepEval source-grounding regression runner. Enable only with
# `docker compose --profile deepeval-evaluation up --build` after configuring
# one operator-reviewed local OpenAI-compatible judge. It evaluates three fixed
# synthetic evidence/answer pairs with the FaithfulnessMetric and returns only
# aggregate evaluator-accuracy metadata. It never receives a real HAI answer,
# source, credential, workflow, runtime, action, metric input, or caller data,
# and it cannot change routing, policy, verification, memory, approvals, or execution.
HAI_DEEPEVAL_ENABLED=false
HAI_DEEPEVAL_BASE_URL=http://deepeval-runner:8080
HAI_DEEPEVAL_TIMEOUT_SECONDS=180
HAI_DEEPEVAL_MODEL_ID=
HAI_DEEPEVAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_DEEPEVAL_MODEL_API_KEY=

# Optional local Garak prompt-injection safety runner. Enable only with
# `docker compose --profile garak-evaluation up --build` after configuring one
# operator-reviewed local OpenAI-compatible endpoint. It runs one shipped,
# four-case synthetic PromptInject probe and returns aggregate pass/fail
# metadata only. The runner never accepts a caller target, model, prompt,
# probe, report path, command, or data and deletes raw Garak reports.
HAI_GARAK_ENABLED=false
HAI_GARAK_BASE_URL=http://garak-runner:8080
HAI_GARAK_TIMEOUT_SECONDS=150
HAI_GARAK_MODEL_ID=
HAI_GARAK_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_GARAK_MODEL_API_KEY=

# Optional local Langfuse observability bridge. Set this only for an
# operator-hosted, local/private Langfuse instance and a dedicated project key
# pair. HAI can probe the instance health/readiness and, only when an owner
# explicitly requests it, export one fixed aggregate control-plane OTLP span.
# It never exports prompts, source or workflow records, file content, model
# payloads, tokens, credentials, or caller-provided trace data.
HAI_LANGFUSE_ENABLED=false
HAI_LANGFUSE_BASE_URL=http://host.docker.internal:3000
HAI_LANGFUSE_PUBLIC_KEY=
HAI_LANGFUSE_SECRET_KEY=
HAI_LANGFUSE_TIMEOUT_SECONDS=8

# Optional local whisper.cpp transcription. Enable only with
# `docker compose --profile local-transcription up --build` after manually
# placing a reviewed GGML model file in ./whisper-models. The runner receives
# only explicitly selected folders below ./connected-sources; it does not
# record a microphone, accept uploads, download models, contact cloud services,
# or retain raw audio. Trigger transcription from an owner-controlled
# `whisper-audio` source; transcripts enter normal source review as uncertain
# evidence and cannot send, publish, approve, or execute work.
HAI_WHISPER_CPP_ENABLED=false
HAI_WHISPER_CPP_BASE_URL=http://whispercpp-runner:8080
HAI_WHISPER_CPP_TIMEOUT_SECONDS=300
WHISPER_CPP_MODEL_FILE=
WHISPER_CPP_LANGUAGE=auto
WHISPER_CPP_FILE_LIMIT=25
WHISPER_CPP_MAX_AUDIO_BYTES=67108864
WHISPER_CPP_TIMEOUT_SECONDS=180

# --- Optional recovered runners ---------------------------------------------
# Every profile below is disabled until both its HAI_*_ENABLED flag is true and
# its Compose profile is explicitly started. Tokens here are placeholders; use
# different generated local-only values in .env.local. No runner publishes a
# host port. See docs/optional-runtime-profiles.md for activation and boundaries.
#
# Security scans read only named subfolders under ./security-snapshots. Copy a
# disposable snapshot there; never mount the repository, connected-sources, a
# user profile, or the Docker socket into these services. Grype additionally
# requires a separately provisioned offline advisory database in ./grype-db.
HAI_GITLEAKS_ENABLED=false
HAI_GITLEAKS_RUNNER_URL=http://gitleaks-runner:8080
HAI_GITLEAKS_RUNNER_TOKEN=change-me-gitleaks-runner-local-only
HAI_GITLEAKS_WORKSPACES=
HAI_GITLEAKS_TIMEOUT_SECONDS=120
HAI_GOSEC_ENABLED=false
HAI_GOSEC_RUNNER_URL=http://gosec-runner:8080
HAI_GOSEC_RUNNER_TOKEN=change-me-gosec-runner-local-only
HAI_GOSEC_WORKSPACES=
HAI_GOSEC_TIMEOUT_SECONDS=120
HAI_GRYPE_ENABLED=false
HAI_GRYPE_RUNNER_URL=http://grype-runner:8080
HAI_GRYPE_RUNNER_TOKEN=change-me-grype-runner-local-only
HAI_GRYPE_WORKSPACES=
HAI_GRYPE_TIMEOUT_SECONDS=120
HAI_SYFT_ENABLED=false
HAI_SYFT_RUNNER_URL=http://syft-runner:8080
HAI_SYFT_RUNNER_TOKEN=change-me-syft-runner-local-only
HAI_SYFT_WORKSPACES=
HAI_SYFT_TIMEOUT_SECONDS=120
HAI_TRIVY_ENABLED=false
HAI_TRIVY_RUNNER_URL=http://trivy-runner:8080
HAI_TRIVY_RUNNER_TOKEN=change-me-trivy-runner-local-only
HAI_TRIVY_WORKSPACES=
HAI_TRIVY_TIMEOUT_SECONDS=120

# Fixed no-tool planning runners use the same canonical local provider/model
# pair configured for HAI (normally Ollama on host.docker.internal). Set
# OLLAMA_BASE_URL and OLLAMA_MODEL_IDS to the matching reviewed provider/model;
# the maintenance gate rejects any planning model outside that policy. Each
# runner receives a short task plus criteria and returns a review-only draft.
HAI_RUNNER_OLLAMA_IMAGE=ollama/ollama:0.11.10
HAI_AGENT_FRAMEWORK_ENABLED=false
HAI_AGENT_FRAMEWORK_BASE_URL=http://agent-framework-runner:8080
HAI_AGENT_FRAMEWORK_TIMEOUT_SECONDS=120
HAI_AGENT_FRAMEWORK_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_AGENT_FRAMEWORK_LOCAL_MODEL_ID=
HAI_AGENT_FRAMEWORK_LOCAL_MODEL_API_KEY=
HAI_CREWAI_ENABLED=false
HAI_CREWAI_BASE_URL=http://crewai-runner:8080
HAI_CREWAI_TIMEOUT_SECONDS=120
HAI_CREWAI_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434/v1
HAI_CREWAI_LOCAL_MODEL_ID=
HAI_CREWAI_LOCAL_MODEL_API_KEY=

# Local document extraction. Office/HTML/Markdown/text input remains read-only.
# PDF parsing is separately disabled until reviewed local artifacts are placed
# under ./docling-models; the runner never downloads models at runtime.
HAI_DOCLING_ENABLED=false
HAI_DOCLING_RUNNER_URL=http://docling-runner:8080
HAI_DOCLING_RUNNER_TOKEN=change-me-docling-runner-local-only
HAI_DOCLING_TIMEOUT_SECONDS=180
HAI_DOCLING_PDF_ENABLED=false

# Disposable mini-SWE patch proposals. Exactly one named snapshot under
# ./mini-swe-workspaces may be allowed. HAI pulls/checks the configured model
# through the isolated Ollama gate, but never applies, commits, or pushes a diff.
HAI_MINISWE_ENABLED=false
HAI_MINISWE_RUNNER_URL=http://miniswe-runner:8080
HAI_MINISWE_RUNNER_TOKEN=change-me-miniswe-runner-local-only
HAI_MINISWE_WORKSPACES=
HAI_MINISWE_TIMEOUT_SECONDS=300
HAI_MINISWE_MODEL_ID=

# Observability remains bridge-only: this repository does not ship reviewed
# MLflow or OpenLIT servers. Point only to an operator-hosted local/private
# instance after separate retention, access, deletion, and egress review.
HAI_MLFLOW_ENABLED=false
HAI_MLFLOW_BASE_URL=
HAI_MLFLOW_BEARER_TOKEN=
HAI_MLFLOW_EXPERIMENT_IDS=
HAI_MLFLOW_METRIC_KEYS=
HAI_MLFLOW_TIMEOUT_SECONDS=8
HAI_OPENLIT_ENABLED=false
HAI_OPENLIT_OTLP_ENDPOINT=
HAI_OPENLIT_TIMEOUT_SECONDS=8

# Optional manifest-approved Wasmtime helpers. Do not enable before placing
# reviewed .wasm files in ./wasi-modules and recording their SHA-256 values.
HAI_WASI_ENABLED=false
HAI_WASI_RUNNER_URL=http://wasi-runner:8080
HAI_WASI_RUNNER_TOKEN=change-me-wasi-runner-local-only
HAI_WASI_MODULES=[]

# Nginx config manager.
CONFIG_DIR=/app/sites-enabled
# Docker-socket reload is intentionally unsupported; use an approved deployment
# operation to reload the gateway after generated configuration changes.
NGINX_RELOAD_ENABLED=false
