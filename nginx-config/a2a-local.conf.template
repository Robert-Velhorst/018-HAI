events {
    worker_connections 64;
}

http {
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    server {
        listen 80;
        set $backend_upstream backend:80;

        # This proxy deliberately exposes only the discoverable Agent Card and
        # the separately bearer-authenticated planning endpoint. It has no
        # browser session, application API, or frontend fallback.
        location = /.well-known/agent-card.json {
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location = /api/v1/a2a {
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Content-Type $content_type;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location / {
            return 404;
        }
    }
}
