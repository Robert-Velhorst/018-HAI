pid /tmp/nginx.pid;

events {
    worker_connections 64;
}

http {
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    server {
        listen 8080;
        set $backend_upstream backend:80;

        location = /healthz {
            return 204;
        }

        # The host bridge supplies only its dedicated bearer token. This
        # gateway never forwards browser cookies or IDP identity headers.
        location = /api/v1/host-runtime/leases {
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie "";
            proxy_set_header X-HAI-Auth-Subrequest "";
            proxy_set_header X-HAI-Verified-Access-Token "";
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location ^~ /api/v1/host-runtime/leases/ {
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie "";
            proxy_set_header X-HAI-Auth-Subrequest "";
            proxy_set_header X-HAI-Verified-Access-Token "";
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location / {
            return 404;
        }
    }
}
