events {
    worker_connections 1024;
}
http {
    server_tokens off;
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;
    server {
        listen 80;

        # Resolve Docker service names per request so replacing a container
        # cannot leave the gateway pinned to its former IP address.
        set $backend_upstream backend:80;
        set $idp_upstream idp:8080;
        set $frontend_upstream frontend:80;
        set $generic_auto_upstream generic-auto:80;

        # Health endpoints are intentionally unauthenticated and must not fall
        # through to the Angular single-page application.
        location = /healthz {
            proxy_pass http://$backend_upstream;
        }

        location = /readyz {
            proxy_connect_timeout 2s;
            proxy_read_timeout 3s;
            proxy_send_timeout 3s;
            proxy_pass http://$backend_upstream;
        }

        # The IDP's readiness handler returns only {status: ready|not_ready};
        # proxy it directly so Nginx's rewrite-phase `return` cannot bypass an
        # auth_request check in the later access phase.
        location = /_hai/idp-readyz {
            proxy_pass http://$idp_upstream/readyz;
            proxy_pass_request_body off;
            proxy_pass_request_headers off;
            proxy_set_header Content-Length "";
            proxy_set_header Host idp;
            proxy_connect_timeout 2s;
            proxy_read_timeout 3s;
            proxy_send_timeout 3s;
        }

        location = /api/v1/agent-runtimes/openclaw/ecosystem/upload {
            client_max_body_size 752m;
            proxy_request_buffering off;
            proxy_read_timeout 15m;
            proxy_send_timeout 15m;
            auth_request /auth-verify;
            # Propagate the rotated access/refresh cookie pair returned by the
            # IDP auth subrequest so later requests use the new refresh token.
            auth_request_set $hai_refreshed_access_cookie $upstream_http_x_hai_refreshed_access_cookie;
            auth_request_set $hai_refreshed_refresh_cookie $upstream_http_x_hai_refreshed_refresh_cookie;
            auth_request_set $hai_verified_access_token $upstream_http_x_hai_verified_access_token;
            add_header Set-Cookie $hai_refreshed_access_cookie always;
            add_header Set-Cookie $hai_refreshed_refresh_cookie always;
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization "Bearer $hai_verified_access_token";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        # Authentication and account-management endpoints belong to the IDP.
        # Keep these explicit so every other product API can use the scalable
        # authenticated backend catch-all below without a route allowlist that
        # silently turns newly added modules into gateway 404s.
        location = /api/v1/auth/local-preview {
            proxy_pass http://$idp_upstream;
            proxy_set_header Host $host;
            proxy_set_header Origin $http_origin;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "";
            # Overwrite any browser-supplied value; this credential is never
            # forwarded to the browser or injected into other IDP routes.
            proxy_set_header X-HAI-Local-Preview-Gateway-Secret "${LOCAL_PREVIEW_GATEWAY_SECRET}";
            proxy_hide_header X-HAI-Verified-Access-Token;
            proxy_hide_header X-HAI-Refreshed-Access-Cookie;
            proxy_hide_header X-HAI-Refreshed-Refresh-Cookie;
        }

        location ^~ /api/v1/auth/ {
            proxy_pass http://$idp_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "";
            proxy_hide_header X-HAI-Verified-Access-Token;
            proxy_hide_header X-HAI-Refreshed-Access-Cookie;
            proxy_hide_header X-HAI-Refreshed-Refresh-Cookie;
        }

        location ^~ /api/v1/user/ {
            proxy_pass http://$idp_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "";
            proxy_hide_header X-HAI-Verified-Access-Token;
            proxy_hide_header X-HAI-Refreshed-Access-Cookie;
            proxy_hide_header X-HAI-Refreshed-Refresh-Cookie;
        }

        # OAuth callback: Google redirects the user's browser here after
        # consent, with no HAI session, so it cannot sit behind auth_request.
        # It is protected instead by the HMAC-signed state the backend issued,
        # and gated read-only by the backend (a public caller resolves to viewer).
        location = /api/v1/sources/oauth/google/callback {
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        # The Windows host-runtime bridge has its own loopback-only proxy and
        # dedicated bearer credential. It must never be reachable via this
        # dashboard gateway, including when the operator opts into ngrok.
        location ^~ /api/v1/host-runtime/ {
            return 404;
        }

        # Agent bridge protocols have their own dedicated local-only entry
        # points. They must not inherit the dashboard API catch-all: browser
        # authentication is neither their authority nor their network boundary.
        location = /api/v1/a2a {
            return 404;
        }

        location ^~ /api/v1/a2a/ {
            return 404;
        }

        location ^~ /api/v1/mcp-agent/ {
            return 404;
        }

        # All non-IDP APIs are backend APIs. Authentication is checked by the
        # IDP subrequest and only its verified token is forwarded as identity.
        # The backend still enforces its own owner and RBAC checks.
        location /api/v1 {
            auth_request /auth-verify;
            auth_request_set $hai_refreshed_access_cookie $upstream_http_x_hai_refreshed_access_cookie;
            auth_request_set $hai_refreshed_refresh_cookie $upstream_http_x_hai_refreshed_refresh_cookie;
            auth_request_set $hai_verified_access_token $upstream_http_x_hai_verified_access_token;
            add_header Set-Cookie $hai_refreshed_access_cookie always;
            add_header Set-Cookie $hai_refreshed_refresh_cookie always;
            proxy_pass http://$backend_upstream;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization "Bearer $hai_verified_access_token";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Backend-Key ${BACKEND_API_SHARED_KEY};
        }

        location /auth-verify {
            internal;
            proxy_pass http://$idp_upstream/api/v1/auth/is-user-authenticated;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-HAI-Auth-Subrequest "1";
        }

        error_page 401 /login;

        include /etc/nginx/sites-enabled/*.conf;

        location / {
            proxy_pass http://$frontend_upstream;
        }
    }
}
