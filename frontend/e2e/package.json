{
  "name": "hai-e2e",
  "private": true,
  "packageManager": "npm@12.2.1",
  "description": "Browser-level end-to-end acceptance tests for the HAI operator flow. Self-contained so it does not affect the Angular app build.",
  "engines": {
    "node": "^26.12.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/auth-smoke.spec.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --project tsconfig.json",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
