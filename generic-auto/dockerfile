FROM golang:1.25.13-alpine@sha256:844b27705f54e73773e0f9bc3c780633b9d7f4b4831bf35cdad02a81a4c80bd0 AS build

WORKDIR /src
COPY go.mod server.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server ./server.go

FROM scratch
COPY --from=build --chown=65532:65532 /out/server /server
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/server"]
