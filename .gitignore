# Local operator configuration. Keep committed examples only.
.env
.env.local
.env.*.local

# Local runtime state.
db_data_automation/
db_data_idp/
images/
backups/
nginx-config/sites-enabled/.hai-event-inbox/

# Dependencies and build output.
frontend/node_modules/
frontend/.npm-cache/
frontend/dist/
backend/images/
backend/.gocache-*/
**/__pycache__/
*.py[cod]
.pytest_cache/

# OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local verification artifacts (may contain session tokens, build logs).
.verify/
.playwright-mcp/
.playwright-cli/
workflow-*.png
security-snapshots/

# Environment backups. Never deliver these — a backup of .env.local carries the
# same real local secrets. Covers .env.local.bak and any *.bak.
*.bak
.env*.bak

# Connected-source ingestion data and personal fixtures (client emails, exported
# threads, sync summaries). Keep the folder, never the contents.
/connected-sources/*
!/connected-sources/.gitkeep
!/connected-sources/e2e-fixture/
!/connected-sources/e2e-fixture/.gitkeep

# Generated diagnostics, work reports, and support bundles.
/*.pdf
support-bundle-*.zip
support-bundle-*.tar.gz

# Generated Windows installer payloads and executables.
/installer/release/

# Local tooling and agent runtime state (not part of the delivered product).
.claude/
/agent-workspaces/*
!/agent-workspaces/.gitkeep
mini-swe-workspaces/
hai-repo-link/

# Local deployment stamps and extracted frontend bundles.
backend/.hai-backend-deploy
frontend/.hai-frontend-deploy/
